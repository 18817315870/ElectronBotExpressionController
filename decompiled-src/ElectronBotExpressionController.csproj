<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ElectronBotExpressionController</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <GenerateApplicationConfiguration>false</GenerateApplicationConfiguration>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup>
    <Compile Update="ElectronBotExpressionController\MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="ElectronBotExpressionController\MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <EmbeddedResource Update="ElectronBotExpressionController\MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ElectronBot.DotNet" Version="1.0.6" />
    <PackageReference Include="ElectronBot.DotNet.LibUsb" Version="1.0.6" />
    <PackageReference Include="ElectronBot.DotNet.WinUsb" Version="1.0.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Assets\**\*">
      <LinkBase>Assets</LinkBase>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
